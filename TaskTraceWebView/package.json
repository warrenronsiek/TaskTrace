    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.4",
    "jsdom": "^29.0.2",
    "vitest": "^4.1.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "d3": "^7.9.0"
  }
}
