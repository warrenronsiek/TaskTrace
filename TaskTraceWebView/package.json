{
  "name": "tasktrace-webview",
  "version": "1.0.0",
  "private": true,
  "description": "Bundled web views for the TaskTrace macOS app",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "benchmark:knowledge-graph": "npm run build && node ./scripts/knowledgeGraphBenchmarkServer.mjs",
