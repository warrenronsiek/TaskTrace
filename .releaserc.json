{
  "branches": [
    {
      "name": "master"
    },
    {
      "name": "dev",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "scope": "docs",
            "release": false
          },
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "scope": "ci",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          },
          {
            "type": "fix",
            "release": "minor"
          },
          {
            "scope": "build",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "test",
            "release": false
          },
          {
            "scope": "test",
            "release": false
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "scope": "no-release",
            "release": false
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node versionUpdate.js ${nextRelease.version}"
      }
    ]
  ]
}
