{
  "name": "tasktrace-browser-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild ./src/background.js --bundle --format=esm --platform=browser --target=chrome120 --outfile=./TaskTraceChromeExtension/background.js && esbuild ./src/twitterCapture.js --bundle --format=iife --platform=browser --target=chrome120 --outfile=./TaskTraceChromeExtension/twitterCapture.js && cp ./node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs ./TaskTraceChromeExtension/pdf.worker.mjs",
    "test": "node --test ./test/*.test.js"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "linkedom": "^0.18.12",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205"
  }
}
